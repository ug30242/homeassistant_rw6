<template>
  <div class="page">
    <div class="row"><text class="title">HA Control</text><input class="small" type="button" value="Sync" onclick="sync" /><input class="small" type="button" value="Info" onclick="settings" /></div>
    <div class="filters"><input class="tab" type="button" value="{{ filterLabel }}" onclick="cycleFilter" /><text class="count">{{ countLabel }}</text></div>
    <text class="hint">Tap a card to view and control.</text>
    <text class="empty" if="{{ !items.length }}">{{ emptyText }}</text>
    <list class="list" if="{{ items.length }}">
      <list-item type="entity" class="card" for="{{ (idx, item) in items }}" onclick="detail(idx)">
        <image class="glyph" src="{{ item.iconPath }}" />
        <div class="entity"><text class="kind">{{ item.kind }}</text><text class="name">{{ item.name }}</text><text class="group" if="{{ item.group }}">{{ item.group }}</text></div>
        <text class="arrow">&gt;</text>
      </list-item>
    </list>
  </div>
</template>
<script>
import router from '@system.router';
import {store} from '../../common/runtime';
import {displayName,displayText,iconPath,entityKind} from '../../common/config';
export default {
  private:{items:[],filterLabel:'Favorites',countLabel:'',emptyText:'Loading saved list...',filter:0},
  onShow(){this.stop();this._visible=true;this.load(this._epoch);},
  async load(epoch){
    try {
      const record=await store.read();if(!this._visible||epoch!==this._epoch)return;
      this._config=record&&!record.config.cleared?record.config:null;this._groups=['Favorites','All'];
      if(this._config)this._config.entities.forEach(e=>{if(e.group&&this._groups.indexOf(e.group)<0)this._groups.push(e.group);});
      if(this.filter>=this._groups.length)this.filter=0;this.render();
    }catch(_){if(this._visible&&epoch===this._epoch){this._config=null;this._shown=[];this.items=[];this.countLabel='';this.emptyText='Storage error. Open Sync or Info.';}}
  },
  render(){
    const all=this._config?this._config.entities:[],label=this._groups[this.filter];
    this.filterLabel=/^[\x20-\x7e]+$/.test(label)?displayText(label):'Group '+(this.filter-1);
    this._shown=all.filter(e=>this.filter===0?e.favorite:this.filter===1?true:e.group===label).sort((a,b)=>Number(b.favorite)-Number(a.favorite)||a.order-b.order);
    this.items=this._shown.map(e=>({name:displayName(e),kind:entityKind(e)+(e.favorite?' | Favorite':''),iconPath:iconPath(e),group:e.group&&/^[\x20-\x7e]+$/.test(e.group)?displayText(e.group):''}));
    this.countLabel=this.items.length+' / '+all.length;
    this.emptyText=all.length?(this.filter===0?'No favorites. Tap Favorites for All.':'No entities in this group.'):'Sync settings from Android.';
  },
  cycleFilter(){if(!this._visible||!this._groups)return;this.filter=(this.filter+1)%this._groups.length;this.render();},
  detail(idx){if(!this._visible)return;const e=this._shown&&this._shown[Number(idx)];if(e)router.push({uri:'pages/detail',params:{entityId:e.id}});},
  sync(){router.push({uri:'pages/receive'});},settings(){router.push({uri:'pages/settings'});},
  stop(){this._visible=false;this._epoch=(this._epoch||0)+1;},
  onHide(){this.stop();},onDestroy(){this.stop();}
};
</script>
<style>
.page { width:432px; height:514px; padding:18px 20px; flex-direction:column; background-color:#090f19; }
.row { width:392px; height:54px; flex-direction:row; justify-content:space-between; align-items:center; }
.title { width:216px; font-size:28px; color:#f8fafc; }
.small { width:78px; height:48px; border-radius:16px; font-size:21px; color:#f8fafc; background-color:#243247; }
.filters { width:392px; height:52px; flex-direction:row; align-items:center; justify-content:space-between; }
.tab { width:252px; height:46px; border-radius:16px; font-size:22px; color:#7dd3fc; background-color:#14283c; }
.count { width:120px; font-size:21px; color:#cbd5e1; text-align:right; }
.hint { width:392px; height:32px; color:#94a3b8; font-size:19px; }
.list { width:392px; height:340px; }
.card { width:392px; height:136px; margin-bottom:10px; padding:14px; border-radius:20px; background-color:#142132; flex-direction:row; align-items:center; }
.glyph { width:48px; height:48px; margin-right:12px; }
.entity { width:276px; flex-direction:column; }
.kind { width:276px; height:24px; font-size:19px; color:#7dd3fc; lines:1; text-overflow:ellipsis; }
.name { width:276px; height:62px; font-size:26px; color:#f8fafc; lines:2; text-overflow:ellipsis; }
.group { width:276px; height:22px; font-size:18px; color:#94a3b8; lines:1; text-overflow:ellipsis; }
.arrow { width:24px; font-size:28px; color:#7dd3fc; text-align:right; }
.empty { width:392px; height:150px; font-size:25px; color:#cbd5e1; }
</style>
