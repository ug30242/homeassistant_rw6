<template>
  <div class="page">
    <div class="row"><text class="title">{{ name }}</text><input class="back" type="button" value="Back" onclick="back" /></div>
    <text class="value">{{ value }}</text><text class="status">{{ status }}</text>
    <input class="refresh" type="button" value="Refresh state" onclick="refresh" />
    <list class="list"><list-item type="action" class="action-row" for="{{ (idx, item) in actions }}"><input class="action" type="button" value="{{ item.label }}" onclick="run(idx)" /></list-item></list>
    <text class="hint" if="{{ !actions.length }}">{{ hint }}</text>
  </div>
</template>
<script>
import router from '@system.router';
import {store,client} from '../../common/runtime';
import {displayName,displayText} from '../../common/config';
import {commands,execute} from '../../common/entities';
export default {
  public:{entityId:''},private:{name:'Entity',value:'Not loaded',status:'Loading...',actions:[],hint:'Read only or unavailable.'},
  onShow(){this.stop();this._visible=true;const epoch=this._epoch;this.load(epoch);},
  async load(epoch){try{
    const record=await store.read();if(!this._visible||epoch!==this._epoch)return;
    this._entity=record&&record.config.entities.find(e=>e.id===this.entityId);
    if(!this._entity){this.status='Entity removed. Sync configuration.';return;}
    this.name=displayName(this._entity);this._client=client(record.config);await this.refresh();
  }catch(_){if(this._visible&&epoch===this._epoch)this.status='Configuration unavailable.';}},
  showState(state){this._state=state;const a=state.attributes||{};this.value=displayText(state.state)+' '+displayText(a.unit_of_measurement||'');this.actions=commands(this._entity,state);},
  async refresh(){
    if(this._busy||!this._client)return;this._busy=true;const epoch=this._epoch;this.status='Updating...';
    try{const state=await this._client.state(this.entityId);if(!this._visible||epoch!==this._epoch)return;this.showState(state);this.status='Current state fetched.';}
    catch(error){if(this._visible&&epoch===this._epoch){this.status='STALE | '+error.message;this.actions=[];}}
    finally{if(epoch===this._epoch)this._busy=false;}
  },
  async run(index){
    if(this._busy||!this._state||!this._client||Date.now()-(this._lastTap||0)<1000)return;
    const command=this.actions[Number(index)];if(!command)return;
    this._lastTap=Date.now();this._busy=true;const epoch=this._epoch;this.status='Sending...';
    try{
      const result=await execute(this._client,this._entity,command,this._state,{active:()=>this._visible&&epoch===this._epoch,delay:ms=>new Promise(resolve=>{this._delayResolve=resolve;this._delay=setTimeout(()=>{this._delay=null;this._delayResolve=null;resolve();},ms);})});
      if(!this._visible||epoch!==this._epoch)return;this.showState(result.state);this.status=result.message;
    }catch(error){if(this._visible&&epoch===this._epoch){this.status=error.message;this.actions=[];}}
    finally{if(epoch===this._epoch)this._busy=false;}
  },
  stop(){this._visible=false;this._epoch=(this._epoch||0)+1;this._busy=false;if(this._client)this._client.close();this._client=null;if(this._delay)clearTimeout(this._delay);if(this._delayResolve)this._delayResolve();this._delay=null;this._delayResolve=null;},
  onHide(){this.stop();},onDestroy(){this.stop();},back(){router.back();}
};
</script>
<style>
.page { width:432px; height:514px; padding:18px 20px; flex-direction:column; background-color:#090f19; }
.row { width:392px; height:54px; flex-direction:row; align-items:center; justify-content:space-between; }
.title { width:290px; font-size:27px; color:#f8fafc; lines:1; text-overflow:ellipsis; }
.back { width:86px; height:50px; border-radius:16px; background-color:#243247; color:#f8fafc; font-size:21px; }
.value { width:392px; height:54px; color:#38bdf8; font-size:32px; lines:1; text-overflow:ellipsis; }
.status { width:392px; height:76px; font-size:21px; color:#cbd5e1; }
.refresh { width:392px; height:54px; border-radius:18px; background-color:#243247; color:#f8fafc; font-size:23px; }
.list { width:392px; height:224px; margin-top:10px; }
.action-row { width:392px; height:66px; }
.action { width:392px; height:58px; border-radius:18px; font-size:25px; color:#f8fafc; background-color:#075985; }
.hint { color:#94a3b8; font-size:20px; }
</style>
